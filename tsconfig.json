{
  "compilerOptions": {
    "target": "es2022", "module": "esnext", "moduleResolution": "bundler", "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "resolveJsonModule": true, "skipLibCheck": true,
    "erasableSyntaxOnly": true, "types": []
  },
  "include": ["src", "web", "hosting/*.ts", "hosting/*.d.ts"]
}
